# Atlas by Vylex Technologies — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# OpenRouter API Key (get one free at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI Model ID (free models: stealth/ox-alpha, openrouter/free, openrouter/owl-alpha)
OPENROUTER_MODEL=stealth/ox-alpha

# HTTP Server Port
PORT=3000

# Image Search API Keys (optional — images work without Pexels, Unsplash/Pixabay are used)
UNSPLASH_ACCESS_KEY=your_unsplash_key
PIXABAY_API_KEY=your_pixabay_key
