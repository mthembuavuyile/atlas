{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...slug].js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/models",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/capabilities",
      "destination": "/docs.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    }
  ]
}
